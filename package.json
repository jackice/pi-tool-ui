    "prepack": "npm run build"
  },
  "dependencies": {
    "@jackice/pi-ui": "0.8.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@earendil-works/pi-tui": "^1.6.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@earendil-works/pi-tui": "1.6.0",
    "@types/node": "^24.0.0",
    "oxlint": "^1.95.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
