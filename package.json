{
  "name": "@jackice/pi-tool-ui",
  "version": "1.0.0",
  "description": "Tool renderer cards for Pi: migration-compatible Edit/Hashline diff views.",
  "type": "module",
  "license": "MIT",
  "author": "jackice",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jackice/pi-tool-ui.git"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
